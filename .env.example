# Application
APP_NAME=TechTaurant Main API
SERVER_PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techtaurant
DB_USERNAME=root
DB_PASSWORD=1234

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MS=3600000
JWT_REFRESH_TOKEN_EXPIRE_MS=604800000

# OAuth2 Redirect
OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth/callback
OAUTH2_FAILURE_REDIRECT_URL=http://localhost:3000/oauth/error

# CORS
# 허용할 Origin 패턴을 쉼표로 구분하여 지정
# 개발 환경: 프론트엔드 로컬 주소 또는 https://*.techtaurant.com:[*] 형식
# 프로덕션: fallback에 사용할 구체 origin을 먼저 두고, 소유한 도메인 범위의 패턴만 추가
# 패턴 매칭 시 요청 origin이 응답되므로 allowCredentials=true와 함께 사용할 수 있음
CORS_ORIGINS=https://local.techtaurant.com:3010,http://localhost:3000

# Cookie Settings
# COOKIE_SECURE: HTTPS에서만 쿠키 전송 (개발: false, 프로덕션: true)
# COOKIE_HTTP_ONLY: JavaScript에서 쿠키 접근 차단 (보안상 true 권장)
# COOKIE_SAME_SITE: CSRF 방지 (Strict, Lax, None)
#   Lax 쿠키는 top-level GET 내비게이션에만 실리고 cross-site fetch/XHR에는 붙지 않는다.
#   FE와 API의 eTLD+1이 다른 환경(예: http://localhost:3000 -> https://dev-api.techtaurant.com)은
#   None으로 두어야 로그인 상태가 유지되며, None은 반드시 COOKIE_SECURE=true와 함께 사용해야 한다.
# COOKIE_PATH: 쿠키 유효 경로
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax
COOKIE_PATH=/

# Swagger
# 개발 환경: http://localhost:8080
SWAGGER_BASE_URL=http://localhost:8080

# Monitoring
# prod로 설정하면 Swagger UI/API docs, p6spy SQL logging, 개발용 테스트 인증 API가 비활성화됩니다.
APP_ENVIRONMENT=dev
MONITORING_METRICS_USERNAME=prometheus
MONITORING_METRICS_PASSWORD=change-me-prometheus-password
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
